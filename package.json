{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mynameistito-workspace1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev:all": "turbo run dev --ui=tui",
    "dev:cli": "bun run --cwd packages/mynameistito dev",
    "dev:website": "bun run --cwd apps/website dev",
    "changeset": "changeset",
    "changeset-add": "bun run scripts/changeset-add.ts",
    "changeset-version": "changeset version && bun install --lockfile-only",
    "check": "ultracite check",
    "knip": "knip",
    "release:stage": "bun scripts/cicd/stage-packages.ts",
    "release:tag": "bun scripts/cicd/git-tag.ts",
    "test": "turbo run test:root",
    "test:root": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-report.junit.xml",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "^0.2.0",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^5.0.3",
    "alchemy": "2.0.0-beta.80",
    "effect": "catalog:",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.40.0",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-react-doctor": "^0.9.17",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "effect": "4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
