{
  "compilerOptions": {
    "lib": ["ES2022", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/__tests__/**/*.ts",
    "**/*.config.ts"
  ],
  "exclude": ["**/dist"]
}
