{
  "compilerOptions": {
    "lib": ["ES2023", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    ".github/scripts/update-projects.mjs",
    "scripts/**/*.ts",
    "packages/**/src/**/*.ts",
    "packages/**/__tests__/**/*.ts",
    "**/*.config.ts"
  ],
  "exclude": ["**/dist"]
}
