{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mynameistito/website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "fix": "ultracite fix",
    "check": "ultracite check",
    "dev": "varlock run --inject vars -- bun run --cwd ../.. alchemy dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun --env-file=.env.production run varlock run --inject vars -- bun run --cwd ../.. alchemy deploy --stage prod --yes",
    "env:check": "varlock load --agent",
    "env:check:prod": "bun --env-file=.env.production run varlock load --agent",
    "env:scan": "bun --env-file=.env.production run varlock load --agent && bun --env-file=.env.production run varlock scan src dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json"
  },
  "dependencies": {
    "@distilled.cloud/github": "1.0.0-rc.13",
    "@distilled.cloud/resend": "1.0.0-rc.13",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "effect": "catalog:",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grab": "^0.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "catalog:",
    "vite": "^8.3.3"
  },
  "packageManager": "bun@1.4.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
