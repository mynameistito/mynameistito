{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mynameistito/website",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "fix": "ultracite fix",
    "check": "ultracite check",
    "dev": "2password env resolve .env.tpl --output .dev.vars && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "2password env run .dev.vars.tpl -- bun run --cwd ../.. alchemy deploy --stage prod --yes",
    "cf-typegen": "cf workers types --quiet",
    "typecheck": "bun run cf-typegen && tsc --noEmit"
  },
  "dependencies": {
    "@distilled.cloud/github": "1.0.0-rc.13",
    "@distilled.cloud/resend": "1.0.0-rc.13",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "effect": "catalog:",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grab": "^0.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.12",
    "typescript": "catalog:",
    "vite": "^8.3.3"
  },
  "packageManager": "bun@1.4.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
