{
  "name": "mynameistito",
  "version": "0.2.0",
  "description": "A tiny terminal profile card for Tito.",
  "keywords": [
    "github",
    "npm",
    "portfolio",
    "profile"
  ],
  "license": "MIT",
  "author": "Tito <https://github.com/mynameistito>",
  "bin": {
    "mynameistito": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsgo --project tsconfig.json",
    "dev": "bun src/cli.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@typescript/native-preview": "7.0.0-dev.20260628.1",
    "tsdown": "^0.22.3"
  },
  "engines": {
    "node": ">=20"
  }
}
