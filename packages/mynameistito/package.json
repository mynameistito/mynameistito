{
  "name": "mynameistito",
  "version": "0.3.6",
  "description": "Tito's live portfolio website in your terminal, built with OpenTUI.",
  "keywords": [
    "github",
    "npm",
    "portfolio",
    "profile"
  ],
  "license": "MIT",
  "author": "Tito <https://github.com/mynameistito>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mynameistito/mynameistito.git",
    "directory": "packages/mynameistito"
  },
  "bin": {
    "mynameistito": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsrs --project tsconfig.json",
    "dev": "bun src/cli.ts",
    "fix": "ultracite fix",
    "check": "ultracite check",
    "typecheck": "tsrs --noEmit",
    "test:terminal": "bun __tests__/terminal.check.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.8.4",
    "cheerio": "^1.2.0",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "^0.23.1",
    "tsrs": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
