{
  "name": "mynameistito",
  "version": "0.1.0",
  "description": "A tiny terminal profile card for Tito.",
  "keywords": [
    "github",
    "npm",
    "portfolio",
    "profile"
  ],
  "license": "MIT",
  "author": "Tito <https://github.com/mynameistito>",
  "bin": {
    "mynameistito": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --project tsconfig.json",
    "dev": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
