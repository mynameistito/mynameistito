{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#test:root": {
      "outputs": ["coverage/**", "test-report.junit.xml"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#typecheck:root": {}
  }
}
